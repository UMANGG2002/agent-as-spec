# --- Core ---
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./marketplace.db
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=capability_marketplace

# --- Auth / delegation ---
# Dev-only symmetric signing key. Use an asymmetric key + KMS in production.
JWT_SIGNING_KEY=dev-only-change-me
JWT_ISSUER=capability-marketplace
ACCESS_TOKEN_TTL_SECONDS=900
DELEGATED_TOKEN_TTL_SECONDS=120

# --- LLM / ADK ---
# Leave everything in this section unset to run the planner in
# offline/deterministic mode (no live model calls) -- see app/config.py's
# `planner_is_live`. Two ways to go live, pick one:
#
# 1) Google's native Gemini API:
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# 2) Any OpenAI-compatible endpoint via LiteLLM (a self-hosted gateway, a
#    multi-provider proxy, etc.) -- needs `pip install -e ".[litellm]"`.
#    If both this and GOOGLE_API_KEY above are set, this one wins.
#    LLM_MODEL_NAME is the model id *your gateway* expects (an alias it
#    registered), not a real OpenAI model name.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# When empty, traces/metrics are printed to the console exporter instead.

# --- Notifications (Composio) ---
COMPOSIO_API_KEY=

# =====================================================================
# Production / staging (see docs/PRODUCTION_ARCHITECTURE.md). With
# ENVIRONMENT=staging|production the app refuses to start on dev defaults.
# Generate keys: python scripts/gen_keys.py
# =====================================================================
# ENVIRONMENT=production
# RUNNER_MODE=queue                      # API enqueues; runner workers execute
# DATABASE_URL=postgresql+asyncpg://agentspec_app:...@pgbouncer:6432/agentspec
# DATABASE_MIGRATION_URL=postgresql+asyncpg://owner:...@postgres:5432/agentspec
# DATABASE_READ_URL=                     # optional read replica
# SESSION_DATABASE_URL=                  # optional separate DB for ADK session events
# DB_BEHIND_PGBOUNCER=true
# REDIS_URL=redis://redis:6379/0
# REDIS_CLUSTER=false
# JWT_ALGORITHM=RS256
