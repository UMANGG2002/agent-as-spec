# Defaults for the local dev stack (sourced by scripts/dev.sh). Nothing secret
# lives here, and your own .env is never modified: anything you export in the
# shell wins over these lines, and the LLM settings (GOOGLE_API_KEY,
# LLM_BASE_URL, LLM_API_KEY, LLM_MODEL_NAME) still come from your .env.
#
# Examples:
#   MEMORY_BACKEND=mem0 ./scripts/dev.sh all      # real mem0 on pgvector
#   PG_PORT=5433 ./scripts/dev.sh all             # Postgres already on 5432

export PG_PORT="${PG_PORT:-5432}"
export REDIS_PORT="${REDIS_PORT:-6379}"
export API_PORT="${API_PORT:-8000}"

export ENVIRONMENT="${ENVIRONMENT:-local}"
export DATABASE_URL="${DATABASE_URL:-postgresql+asyncpg://agentspec_app:app_pw@127.0.0.1:${PG_PORT}/agentspec}"
export DATABASE_MIGRATION_URL="${DATABASE_MIGRATION_URL:-postgresql+asyncpg://postgres:owner_pw@127.0.0.1:${PG_PORT}/agentspec}"
export REDIS_URL="${REDIS_URL:-redis://127.0.0.1:${REDIS_PORT}/0}"

# queue = the API enqueues and a separate runner executes (production shape).
# Set RUNNER_MODE=inline to run agents inside the API process instead.
export RUNNER_MODE="${RUNNER_MODE:-queue}"

# mock = in-memory stand-in. mem0 = self-hosted mem0 on the Postgres above;
# it needs an embedding model, so LLM_BASE_URL + LLM_API_KEY must be set.
export MEMORY_BACKEND="${MEMORY_BACKEND:-mock}"
export MEM0_TELEMETRY="${MEM0_TELEMETRY:-False}"

export JWT_SIGNING_KEY="${JWT_SIGNING_KEY:-dev-only-change-me-please-32-bytes!}"
export LOG_LEVEL="${LOG_LEVEL:-INFO}"
